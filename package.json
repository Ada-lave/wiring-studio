{
  "name": "wiring-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Svelte wiring editor with shared HTTP and MCP commands",
  "scripts": {
    "dev": "tsx watch server/index.ts --dev",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "mcp": "tsx server/stdio.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test": "tsx --test tests/model.test.ts tests/integration.test.ts",
    "test:browser": "node tests/browser.cjs",
    "format": "prettier --write src server shared tests vite.config.ts svelte.config.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "esbuild": "^0.28.2",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.0.0",
    "playwright": "^1.56.0",
    "svelte": "^5.0.0",
    "tsx": "^4.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tsconfig/svelte": "^5.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
